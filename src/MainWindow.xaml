<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="栖电 · Peripheral Power" Width="490" Height="760" MinWidth="450" MinHeight="540"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F4F5F1" FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="#23352E" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#395348"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E3E9E0"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,10"/><Setter Property="Foreground" Value="#395348"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <Style TargetType="ScrollViewer"><Setter Property="PanningMode" Value="VerticalOnly"/></Style>
  </Window.Resources>
  <Border BorderBrush="#DCE2D8" BorderThickness="1" Background="#F4F5F1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="49"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="#F4F5F1" Margin="24,0,16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="27" Height="27" CornerRadius="8" Background="#244F3E" Margin="0,0,9,0">
            <Path Data="M 4,11 L 10,3 L 9,9 L 15,9 L 8,18 L 9,11 Z" Fill="#DCECBA" Width="16" Height="19" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="栖电" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="PERIPHERAL POWER" FontFamily="Segoe UI" FontSize="9" Foreground="#8A968B" VerticalAlignment="Center" Margin="10,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="设置" AutomationProperties.Name="设置"/>
          <Button x:Name="HideButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" ToolTip="收起到系统托盘" AutomationProperties.Name="收起到系统托盘"/>
          <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" ToolTip="关闭面板，保持托盘运行" AutomationProperties.Name="关闭面板"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" x:Name="MainPanel" Margin="25,16,25,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
          <Grid>
            <StackPanel><TextBlock Text="设备电量" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="你的桌面设备，一眼掌握。" FontSize="12" Foreground="#879187" Margin="0,7,0,0"/></StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Background="#E6ECDF" CornerRadius="12" Padding="10,5">
              <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#648555" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="MonitorBadge" Text="自动监测" FontSize="10" Foreground="#617651"/></StackPanel>
            </Border>
          </Grid>
          <Border x:Name="DemoBanner" Visibility="Collapsed" Background="#FFF0D2" CornerRadius="9" Padding="12,9" Margin="0,13,0,0">
            <Grid><TextBlock Text="演示模式 · 以下为示例数据" Foreground="#95671F" FontSize="11" VerticalAlignment="Center"/><Button x:Name="ExitDemoButton" Content="返回真实设备" HorizontalAlignment="Right" Padding="5,2" FontSize="10"/></Grid>
          </Border>
        </StackPanel>
        <Border Grid.Row="1" Background="#254B3C" CornerRadius="16" Padding="20,18" Margin="0,21,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="DESKTOP STATUS" FontFamily="Segoe UI" FontSize="9" Foreground="#A5BE9B"/><TextBlock x:Name="SummaryTitle" Text="正在发现你的设备" FontSize="18" Foreground="#F1F5EB" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="SummaryDetail" Text="首次扫描可能需要几秒钟" FontSize="11" Foreground="#B9CABB" Margin="0,7,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="DeviceCount" Text="—" Foreground="#DBEAB9" FontFamily="Segoe UI" FontWeight="Light" FontSize="38" HorizontalAlignment="Right"/><TextBlock Text="已识别设备" FontSize="9" Foreground="#B9CABB"/></StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,19,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal"><Button x:Name="AllButton" Content="全部设备" Background="#E2E8DB" Padding="13,7"/><Button x:Name="LowButton" Content="低电量" Margin="5,0,0,0" Padding="13,7"/></StackPanel>
          <Button Grid.Column="1" x:Name="RefreshButton" Padding="9,7" ToolTip="立即读取设备电量"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/><TextBlock x:Name="RefreshLabel" Text="刷新" FontSize="11"/></StackPanel></Button>
        </Grid>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-5,0" Padding="0,0,5,8">
          <StackPanel x:Name="DeviceList"/>
        </ScrollViewer>
      </Grid>
      <ScrollViewer Grid.Row="1" x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="26,12,26,10">
        <StackPanel>
          <Button x:Name="BackButton" Content="←  返回设备" HorizontalAlignment="Left" Padding="0,8"/>
          <TextBlock Text="偏好设置" FontSize="27" FontWeight="SemiBold" Margin="0,14,0,24"/>
          <TextBlock Text="自动刷新" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="电量变化缓慢，较长间隔更节省资源。" Foreground="#879187" FontSize="11" Margin="0,7,0,13"/>
          <ComboBox x:Name="IntervalCombo" Height="33" SelectedIndex="1" HorizontalAlignment="Left" Width="185"><ComboBoxItem Content="每 30 秒" Tag="30"/><ComboBoxItem Content="每 60 秒 · 推荐" Tag="60"/><ComboBoxItem Content="每 2 分钟" Tag="120"/></ComboBox>
          <Separator Margin="0,24" Background="#E1E5DC"/>
          <TextBlock Text="提醒与启动" FontSize="14" FontWeight="SemiBold"/>
          <CheckBox x:Name="NotificationsCheck" Content="电量低于或等于 20% 时提醒"/>
          <CheckBox x:Name="StartupCheck" Content="登录 Windows 后在托盘启动"/>
          <TextBlock Text="关闭面板后仍会监测；可在托盘菜单中完全退出。" TextWrapping="Wrap" Foreground="#879187" FontSize="11" Margin="0,7,0,0"/>
          <Separator Margin="0,24" Background="#E1E5DC"/>
          <TextBlock Text="设备与适配" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="支持标准 HID 电量及部分罗技 HID++ 2.0 设备。各品牌接收器的电量协议不同，未适配的设备仍会列出。USB/HID 列表也可能包含有线设备。" TextWrapping="Wrap" Foreground="#879187" FontSize="12" LineHeight="21" Margin="0,9,0,13"/>
          <WrapPanel><Button x:Name="DiagnosticsButton" Content="导出诊断信息" Background="White" Margin="0,0,8,8"/><Button x:Name="DemoButton" Content="查看界面演示" Background="White" Margin="0,0,0,8"/></WrapPanel>
          <TextBlock Text="诊断包含设备名称、VID/PID、接口能力和读取结果，不包含原始设备路径或序列号。文件保存在本地，不会自动上传。" TextWrapping="Wrap" FontSize="10" Foreground="#8B958A" LineHeight="18"/>
          <Separator Margin="0,24" Background="#E1E5DC"/>
          <TextBlock Text="栖电  0.1.0" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="轻一点，专注每一局。" Foreground="#8B958A" FontSize="11" Margin="0,7,0,8"/>
          <Button x:Name="QuitButton" Content="完全退出程序" HorizontalAlignment="Left" Padding="0,12" Foreground="#9D715B"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="#E1E5DC" BorderThickness="0,1,0,0" Margin="25,0">
        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse x:Name="FooterDot" Width="5" Height="5" Fill="#79905F" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="FooterText" Text="正在扫描设备…" FontSize="10" Foreground="#849080" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="安静守候 · 随时就绪" FontSize="10" Foreground="#9DA497"/></Grid>
      </Border>
    </Grid>
  </Border>
</Window>
