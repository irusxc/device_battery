<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="栖电 · Peripheral Power" Width="940" Height="520" MinWidth="640" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#151515" FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="#EEEEEE" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#242424"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#242424"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#454545"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#BDBDBD"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,10"/><Setter Property="Foreground" Value="#CCCCCC"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="#242424"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="#3A3A3A"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#EEEEEE"/></Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#DDDDDD"/><Setter Property="BorderBrush" Value="#444444"/></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Height" Value="6"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid x:Name="Rail" Height="4" VerticalAlignment="Center">
        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#464646" CornerRadius="3" Margin="0,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter TargetName="Rail" Property="Height" Value="Auto"/><Setter TargetName="Rail" Property="Width" Value="4"/><Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="6"/><Setter Property="Height" Value="Auto"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Background="#151515">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="37"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="#151515" Margin="26,0,16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 4,11 L 10,3 L 9,9 L 15,9 L 8,18 L 9,11 Z" Fill="#DDDDDD" Width="14" Height="19" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="栖电" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="设置" AutomationProperties.Name="设置"/>
          <Button x:Name="HideButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘"/>
          <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" ToolTip="关闭面板" AutomationProperties.Name="关闭面板"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" x:Name="MainPanel" Margin="28,12,28,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="设备" FontSize="21"/><TextBlock x:Name="DeviceCount" Text="0" Foreground="#808080" FontSize="14" Margin="10,6,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AllButton" Content="全部" Background="#303030" Padding="13,7"/><Button x:Name="LowButton" Content="低电量" Margin="4,0,0,0" Padding="13,7"/><Button x:Name="RefreshButton" Margin="14,0,0,0" ToolTip="刷新设备和电量 · F5"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,7,0"/><TextBlock x:Name="RefreshLabel" Text="刷新" FontSize="12"/></StackPanel></Button></StackPanel>
        </Grid>
        <Border Grid.Row="1" x:Name="DemoBanner" Visibility="Collapsed" Background="#262626" CornerRadius="4" Padding="12,6" Margin="0,14,0,0"><Grid><TextBlock Text="演示数据" Foreground="#ADADAD" FontSize="11" VerticalAlignment="Center"/><Button x:Name="ExitDemoButton" Content="返回真实设备" HorizontalAlignment="Right" Padding="5,2" FontSize="11"/></Grid></Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
          <ScrollViewer x:Name="DeviceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="False" Padding="0,0,0,12"><StackPanel x:Name="DeviceList" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer>
          <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="未发现 USB 设备" FontSize="17" Foreground="#BBBBBB" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDetail" Text="插入设备后会自动更新" FontSize="12" Foreground="#737373" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel>
        </Grid>
      </Grid>
      <ScrollViewer Grid.Row="1" x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="28,8,28,12">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,22"><Button x:Name="BackButton" Content="←" Padding="0,7,16,7"/><TextBlock Text="设置" FontSize="21" VerticalAlignment="Center"/></StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="电量刷新间隔" FontSize="14"/>
              <ComboBox x:Name="IntervalCombo" Height="32" Width="175" Margin="0,12,0,15" SelectedIndex="1" HorizontalAlignment="Left" Background="#2C2C2C" Foreground="#DDDDDD">
                <ComboBox.Template><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Background="#2C2C2C" Foreground="#DDDDDD" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#2C2C2C" Padding="10,5" CornerRadius="4"><DockPanel><TextBlock Text="⌄" DockPanel.Dock="Right" Margin="14,0,0,0"/><ContentPresenter/></DockPanel></Border></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding SelectionBoxItem}"/></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="#303030" Padding="4" MinWidth="175"><StackPanel IsItemsHost="True"/></Border></Popup></Grid></ControlTemplate></ComboBox.Template>
                <ComboBoxItem Content="30 秒" Tag="30"/><ComboBoxItem Content="60 秒" Tag="60"/><ComboBoxItem Content="2 分钟" Tag="120"/>
              </ComboBox>
              <TextBlock Text="插拔时立即检测；每 3 秒检查连接状态。" FontSize="11" Foreground="#858585" TextWrapping="Wrap"/>
              <CheckBox x:Name="NotificationsCheck" Content="电量 ≤ 20% 时提醒" Margin="0,24,0,8"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 后在托盘启动"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="设备支持" FontSize="14"/>
              <TextBlock Text="USB 设备连接状态与电量分开更新。部分设备未公开电量，需单独适配。" Foreground="#999999" FontSize="12" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,14"/>
              <WrapPanel><Button x:Name="DiagnosticsButton" Content="导出诊断" Background="#292929" Margin="0,0,8,8"/><Button x:Name="DemoButton" Content="界面演示" Background="#292929" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock Text="诊断文件保存在本地，不自动上传。" Foreground="#747474" FontSize="11" Margin="0,4,0,20"/>
              <Button x:Name="QuitButton" Content="退出程序" HorizontalAlignment="Left" Background="#292929"/><TextBlock Text="0.2.0" FontFamily="Segoe UI" FontSize="11" Foreground="#666666" Margin="0,20,0,8"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="28,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterText" Text="读取设备…" Foreground="#787878" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SummaryDetail" Grid.Column="1" Text="" Foreground="#787878" FontSize="10" Margin="12,0,0,0"/></Grid>
    </Grid>
  </Border>
</Window>
